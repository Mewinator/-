{
  "name": "Portal",
  "short_name": "Portal",
  "description": "Opens a website of your choice in its own window.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay"],
  "version": "1.1.1",
  "update_manifest_url": "https://github.com/Mewinator/-/releases/latest/download/update.json",
  "background_color": "#dee1e6",
  "theme_color": "#dee1e6",
  "icons": [
    {
      "src": "/icon.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "permissions_policy": {
    "cross-origin-isolated": ["self"],
    "controlled-frame": ["self"],
    "fullscreen": ["self"]
  }
}
